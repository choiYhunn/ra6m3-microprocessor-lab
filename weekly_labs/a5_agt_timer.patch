+void FND_DisplayNum(uint8_t digit, uint8_t num)
+{
+    Segment_Initial_Setting();
+
+    uint8_t output_data = fnd_number[num];
+
+    for(int i = 0; i < 7; i++) {
+        bsp_io_level_t level = (output_data & (1 << (6 - i))) ? BSP_IO_LEVEL_LOW : BSP_IO_LEVEL_HIGH;
+        R_IOPORT_PinWrite(&g_ioport_ctrl, fnd_segment_ledindex[i], level);
+    }
