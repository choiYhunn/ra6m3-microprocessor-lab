+void R_AGT_Callback(timer_callback_args_t *p_args)
+{
+    FSP_PARAMETER_NOT_USED(p_args);
+    if (cycle_count >=10){
+        LED_Initial_Setting();
+        R_AGT_Stop(&g_timer0_ctrl);
+        is_running = false;
+        return;
+    }
+    if(is_running){
+        LED_Initial_Setting();
+        R_IOPORT_PinWrite(&g_ioport_ctrl, led_index[led_step], BSP_IO_LEVEL_LOW);
+        led_step++;
+        if (led_step >= 4) {
+            led_step = 0;
+            cycle_count++;
+        }
+    }
+}
 
+void R_IRQ11_Interrupt(external_irq_callback_args_t *p_args)
+{
+    FSP_PARAMETER_NOT_USED(p_args);
+    if (cycle_count < 10) {
+        is_running = !is_running;
+        if (!is_running) {
+            LED_Initial_Setting();
+            R_AGT_Stop(&g_timer0_ctrl);
+        }
+        else{
+            R_AGT_Start(&g_timer0_ctrl);
+        }
+    }
+}
